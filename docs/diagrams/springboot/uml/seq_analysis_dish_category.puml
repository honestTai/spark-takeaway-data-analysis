@startuml seq_analysis_dish_category
skinparam monochrome true
skinparam shadowing false
autonumber

actor "用户" as U
participant "前端\n菜品类别占比页" as FE
participant "JwtAuthenticationInterceptor" as I
participant "AnalysisController" as C
participant "Spark分析服务\nSparkAnalysisService" as S
database "MySQL\n(dishes + analysis_results)" as DB

U -> FE : 打开菜品类别占比
FE -> I : GET /analysis/dish-category\nAuthorization: Bearer token
I -> I : 校验Token
I -> C : 放行请求

C -> S : analyzeDishCategoryDistribution()
alt 命中内存缓存(dish_category)
  S --> C : List<Map>
  C --> FE : Result.success(data)
else 未命中缓存
  S -> DB : JDBC读取dishes\n并按category分组统计dish_count
  DB --> S : 结果集
  S -> DB : 写入/更新 analysis_results\n(结果缓存)
  S --> C : List<Map>
  C --> FE : Result.success(data)
end

@enduml
