@startuml seq_analysis_merchant_sales
skinparam monochrome true
skinparam shadowing false
autonumber

actor "用户" as U
participant "前端\n商户销量图表页" as FE
participant "JwtAuthenticationInterceptor" as I
participant "AnalysisController" as C
participant "Spark分析服务\nSparkAnalysisService" as S
database "MySQL\n(merchants + analysis_results)" as DB

U -> FE : 打开商户销量排名
FE -> I : GET /analysis/merchant-sales?limit=10\nAuthorization: Bearer token
I -> I : 校验Token
I -> C : 放行请求

C -> S : analyzeMerchantSales(limit)
alt 命中内存缓存
  S --> C : List<Map>
  C --> FE : Result.success(data)
else 未命中缓存
  S -> DB : JDBC读取merchants\n并执行聚合/排序/TopN
  DB --> S : 结果集
  S -> DB : 写入/更新 analysis_results\n(结果缓存)
  S --> C : List<Map>
  C --> FE : Result.success(data)
end

@enduml
