@startuml seq_analysis_price_distribution
skinparam monochrome true
skinparam shadowing false
autonumber

actor "用户" as U
participant "前端\n价格分布图表页" as FE
participant "JwtAuthenticationInterceptor" as I
participant "AnalysisController" as C
participant "Spark分析服务\nSparkAnalysisService" as S
database "MySQL\n(orders + analysis_results)" as DB

U -> FE : 打开价格区间分布
FE -> I : GET /analysis/price-distribution\nAuthorization: Bearer token
I -> I : 校验Token
I -> C : 放行请求

C -> S : analyzePriceDistribution()
alt 命中内存缓存(price_distribution)
  S --> C : List<Map>
  C --> FE : Result.success(data)
else 未命中缓存
  S -> DB : JDBC读取orders\n并按金额区间统计order_count
  DB --> S : 结果集
  S -> DB : 写入/更新 analysis_results\n(结果缓存)
  S --> C : List<Map>
  C --> FE : Result.success(data)
end

@enduml
