<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" 
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.takeaway.analysis.mapper.OrderItemMapper">

    <resultMap id="BaseResultMap" type="com.takeaway.analysis.entity.OrderItem">
        <id column="item_id" property="itemId"/>
        <result column="order_id" property="orderId"/>
        <result column="dish_id" property="dishId"/>
        <result column="dish_name" property="dishName"/>
        <result column="dish_price" property="dishPrice"/>
        <result column="quantity" property="quantity"/>
        <result column="subtotal" property="subtotal"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insert" parameterType="com.takeaway.analysis.entity.OrderItem" useGeneratedKeys="true" keyProperty="itemId">
        INSERT INTO order_items (order_id, dish_id, dish_name, dish_price, quantity, subtotal)
        VALUES (#{orderId}, #{dishId}, #{dishName}, #{dishPrice}, #{quantity}, #{subtotal})
    </insert>

    <select id="selectByOrderId" resultMap="BaseResultMap">
        SELECT * FROM order_items WHERE order_id = #{orderId}
    </select>

    <insert id="batchInsert" parameterType="java.util.List">
        INSERT INTO order_items (order_id, dish_id, dish_name, dish_price, quantity, subtotal)
        VALUES
        <foreach collection="list" item="item" separator=",">
            (#{item.orderId}, #{item.dishId}, #{item.dishName}, #{item.dishPrice}, #{item.quantity}, #{item.subtotal})
        </foreach>
    </insert>

</mapper>

